# syntax=docker/dockerfile:1

# 一次性验收镜像：单元测试 → 类型检查与生产构建 → 对静态产物跑 E2E。
# 容器退出码即验收结论：0 通过，非 0 失败。
FROM node:22-bookworm-slim AS verify
WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Chromium 运行所需的最小系统库；playwright install --with-deps 会补齐其余依赖
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

# 安装 Playwright Chromium 及其系统依赖（镜像内为 root），装到全局路径
RUN npx playwright install --with-deps chromium

COPY . .
# 以非 root 用户运行，避免 Chromium 的 root/no-sandbox 问题
RUN chown -R node:node /app /ms-playwright
USER node

# 独立运行时：Vitest 单测 → tsc + vite build → 起 preview 静态服务器跑 Playwright。
# docker compose 的 verify 服务会覆盖此命令，改为对 web 静态容器执行 E2E。
CMD ["npm", "run", "verify:docker"]
